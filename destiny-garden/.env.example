# ── 필수(운영) ──
AUTH_SECRET=                    # 세션 서명 키 (openssl rand -hex 32)
OPENAI_API_KEY=                 # NPC 상담/리포트
OPENAI_MODEL=gpt-4o             # 모델명은 환경변수로 관리
# ── 결제(토스페이먼츠, 서버 승인) ──
TOSS_SECRET_KEY=                # 결제위젯 시크릿 키 (서버 전용)
NEXT_PUBLIC_TOSS_CLIENT_KEY=    # 결제위젯 클라이언트 키
# ── 선택 ──
KASI_SERVICE_KEY=               # 한국천문연구원 음양력 API 검증용
DATA_DIR=.data                  # 개발용 JSON DB 경로 (테스트는 .data-test 로 분리)
DG_STAGING=1                    # production 빌드에서도 오프라인 AI·가상결제 허용(스테이징/E2E 전용). 운영에서는 설정 금지
